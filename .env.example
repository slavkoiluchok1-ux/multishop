DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Стандартний Redis-сервіс із docker-compose.yml.
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
SITE_URL=http://localhost:8000

MAIN_ADMIN_NICK=
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@multishop.local

# Telegram credentials are configured only in the local .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
